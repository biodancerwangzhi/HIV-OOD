     "output_type": "stream",
     "text": [
      "ood: (23, 19) | epi: (18, 13) | pred: (2658, 6)\n",
      "mat: (23, 8)\n",
      "   drug  class  ood_binary  esm_gain  brier_binary  brier_esm recommendation\n",
      "0   SQV     PI    0.985351 -0.002254      0.045882   0.061395      Binary-LR\n",
      "1   LPV     PI    0.979337 -0.003290      0.053285   0.090057      Binary-LR\n",
      "2   FPV     PI    0.972152 -0.006456      0.057984   0.058524      Binary-LR\n",
      "3   IDV     PI    0.966768  0.001217      0.052291   0.086265      Binary-LR\n",
      "4   ATV     PI    0.944857  0.007429      0.079232   0.124473      Binary-LR\n",
      "5   NFV     PI    0.943978 -0.008996      0.076983   0.152552      Binary-LR\n",
      "6   TPV     PI    0.928950  0.010604      0.123055   0.077278      Binary-LR\n",
      "7   DRV     PI    0.926667 -0.004444      0.090309   0.109677      Binary-LR\n",
      "8   ABC   NRTI    0.837500  0.162500      0.077104   0.025483        ESM-LGB\n",
      "9   AZT   NRTI    0.783279  0.009740      0.149521   0.219706      Binary-LR\n",
      "10  D4T   NRTI    0.779412 -0.082353      0.062752   0.034879      ⚠ Caution\n",
      "11  3TC   NRTI    0.755556  0.165185      0.290116   0.321502        ESM-LGB\n",
      "12  TDF   NRTI    0.671614  0.122449      0.138210   0.067171        ESM-LGB\n",
      "13  DDI   NRTI    0.636364  0.159091      0.039384   0.022597        ESM-LGB\n",
      "14  EFV  NNRTI    0.890538 -0.003011      0.149719   0.164547      Binary-LR\n",
      "15  RPV  NNRTI    0.773333 -0.140000      0.204211   0.405933      ⚠ Caution\n",
      "16  NVP  NNRTI    0.757640  0.079241      0.244174   0.207946        ESM-LGB\n",
      "17  ETR  NNRTI    0.757106 -0.044789      0.229730   0.297910      ⚠ Caution\n",
      "18  RAL    INI    0.906534  0.069479      0.117592   0.056217        ESM-LGB\n",
      "19  EVG    INI    0.868203  0.087558      0.218384   0.097502        ESM-LGB\n",
      "20  BIC    INI    0.828947  0.055263      0.151442   0.078969        ESM-LGB\n",
      "21  DTG    INI    0.770024  0.114988      0.178332   0.125357        ESM-LGB\n",
      "22  CAB    INI    0.749250  0.055472      0.251262   0.146653        ESM-LGB\n"
     ]
