     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "saved /mnt/d/我的项目/生信包复现重构升级/projects/1模型推理型/变异-耐药性预测/HIV-ESM-2/figures/manuscript/fig1/fig1_combined.png\n",
      "saved /mnt/d/我的项目/生信包复现重构升级/projects/1模型推理型/变异-耐药性预测/HIV-ESM-2/figures/manuscript/fig1/fig1_combined.pdf\n",
