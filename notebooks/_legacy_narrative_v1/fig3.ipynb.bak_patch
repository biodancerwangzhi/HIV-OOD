     "text": [
      "saved fig3D_random_minus_subtype_drop.png\n",
      "    class drug  random_esm_lgb  ood_esm_lgb   drop         status\n",
      "22   NRTI  D4T           0.966        0.691  0.275  overestimated\n",
      "21  NNRTI  RPV           0.861        0.637  0.224  overestimated\n",
      "20   NRTI  AZT           0.976        0.798  0.178  overestimated\n",
      "19  NNRTI  ETR           0.871        0.699  0.172  overestimated\n",
      "18   NRTI  TDF           0.960        0.794  0.165  overestimated\n",
      "17    INI  CAB           0.898        0.799  0.100  overestimated\n",
      "16  NNRTI  NVP           0.916        0.836  0.080  overestimated\n",
      "15  NNRTI  EFV           0.929        0.878  0.050  overestimated\n",
